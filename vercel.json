{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-bulk-absent",
      "schedule": "55 2 * * 1"
    }
  ]
}