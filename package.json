{
    "name": "barao-de-maua",
    "version": "1.0.0",
    "private": true,
    "description": "Sistema de Pontuação - Clube de Desbravadores Barão de Mauá",
    "scripts": {
        "build:css": "npx tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
        "dev:css": "npx tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
        "build": "npm run build:css"
    },
    "devDependencies": {
        "tailwindcss": "^3.4.1"
    }
}